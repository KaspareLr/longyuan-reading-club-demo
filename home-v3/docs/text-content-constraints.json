  "contextOverrides": [
    {
      "when": "detail-page primary title (other content metadata follows containerResolution)",
      "policy": "F",
      "previewChars": null,
      "lines": null
    },
    {
      "when": "membership benefit text includes cost, eligibility, period, quota or restriction",
      "policy": "F",
      "previewChars": null,
      "lines": null
    },
    {
      "when": "task range/instructions or co-reading question in a task card (date/countdown remain full)",
      "policy": "M",
      "previewChars": null,
      "lines": 3,
      "desktopLines": 3,
      "mobileLines": 3
    },
    {
      "when": "standalone comment or note without exact-record detail (inside a card use M)",
      "policy": "I",
      "previewChars": 200,
      "desktopLines": 4,
      "mobileLines": 4
    },
    {
      "when": "reading body, AI answer, FAQ, numeric progress, price, date, address, eligibility, error or action label",
      "policy": "F",
      "previewChars": null,
      "lines": null
    }
  ],
  "precedence": [
    "contextOverrides",
    "explicit field rules",
    "component defaults",
    "F as safe fallback"
  ],
  "updated": "2026-11-16",
  "displayOverflow": {
    "indicator": "fade-lower-half-of-last-visible-line-only",
    "actualOverflowOnly": true,
    "preserveFullDOMText": true,
    "ellipsis": false,
    "visibleExpandOrCollapseButtons": false,
    "canonicalSpec": "TEXT-OVERFLOW-POLICY.md",
    "previewChars": "editorial-guidance-only-no-destructive-slicing"
  },
  "runtimeOverrides": "text-overflow.js determines mode per current container: fixed recommendation/card uses M, standalone prose uses I, main titles and critical information use F.",
  "profileOverrides": {
    "source": "ACCOUNT-SOURCE-PARITY.md",
    "visibleFields": [
      "avatar",
      "nickname",
      "email",
      "interests"
    ],
    "emailMax": 150,
    "interestsMax": 60,
    "interestsMaxItems": 8,
    "interestItemMax": 16,
    "excludedFields": [
      "city",
      "bio"
    ]
  },
  "previewPolicyPriority": "List summary/description/excerpt => E, even if historical markup says M. Independent recommendation body and detail prose keep F/I/M.",
  "containerResolution": {
    "priority": [
      "system-copy-and-full-reading-body",
      "list-title-or-excerpt-ellipsis",
      "explicit-full-title-or-critical-fact",
      "actual-card-container",
      "standalone-content-field"
    ],
    "card": {
      "policy": "M",
      "lineBudget": "field-specific, bounded by card layout",
      "visual": "last-line-lower-half-fade",
      "click": "single-field-dialog"
    },
    "standalone": {
      "policy": "I",
      "lineBudget": "field-specific by content role",
      "visual": "last-line-lower-half-fade",
      "click": "expand-inline"
    },
    "legacyInlineModalMarkers": "do-not-override-container",
    "preserveFullSourceText": true
  },
  "visualLimitSource": {
    "file": "text-overflow-limits.css",
    "property": "--to-limit",
    "responsiveHomeProperty": "--v3-lines",
    "runtime": "text-overflow.js reads computed CSS; legacy registration is fallback only",
    "lastUpdated": "2026-11-16"
  },
  "homepageRecommendationHeadline": {
    "field": "recommendationTitle",
    "variants": [
